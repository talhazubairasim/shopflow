{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}"
        }
      },
      "catalog-root": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog"
        }
      },
      "basket": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/api/basket/{**rest}"
        }
      },
      "basket-root": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/api/basket"
        }
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/orders/{**rest}"
        }
      },
      "orders-root": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/orders"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payments/{**rest}"
        }
      },
      "payments-root": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payments"
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**rest}"
        }
      },
      "identity-root": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notifications/{**rest}"
        }
      },
      "notifications-root": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notifications"
        }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "basket": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "payment": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "notification": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5106"
          }
        }
      }
    }
  },
  "Urls": "http://localhost:5100"
}
